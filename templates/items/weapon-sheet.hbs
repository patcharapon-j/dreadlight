<div class="dreadlight sheet item weapon">

  {{!-- Corner brackets --}}
  <div class="corner tl"></div>
  <div class="corner tr"></div>
  <div class="corner bl"></div>
  <div class="corner br"></div>

  {{!-- Top accent line (red variant) --}}
  <div class="accent-top accent-red"></div>

  <div class="item-body">

    {{!-- Header: image, type label, name --}}
    <div class="item-header item-header-red">
      <img class="item-img item-img-red" src="{{itemIcon item}}" data-fallback-src="{{item.img}}" onerror="this.onerror=null; this.src=this.dataset.fallbackSrc;" data-edit="img" title="{{item.name}}" width="36" height="36" />
      <div style="display:flex; flex-direction:column; gap:2px; flex:1; min-width:0;">
        <div class="item-type-label red">
          {{localize "DREADLIGHT.TypeWeapon"}}
          {{#if (eq system.weaponType "ranged")}} — {{upper (localize "DREADLIGHT.WeaponRanged")}}{{else}} — {{upper (localize "DREADLIGHT.WeaponMelee")}}{{/if}}
        </div>
        <input class="item-name-input" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}} />
      </div>
    </div>

    {{!-- Stat grid (3 columns) --}}
    <div class="stat-grid stat-grid-3" style="margin-bottom:12px;">
      <div class="stat-box stat-red">
        <div class="stat-label">{{localize "DREADLIGHT.WeaponDamage"}}</div>
        <input class="stat-value" type="number" name="system.damage" value="{{system.damage}}" min="0" {{#unless editable}}disabled{{/unless}} />
      </div>
      <div class="stat-box stat-gold">
        <div class="stat-label">{{localize "DREADLIGHT.WeaponCrit"}}</div>
        <input class="stat-value" type="number" name="system.critThreshold" value="{{system.critThreshold}}" min="1" max="6" {{#unless editable}}disabled{{/unless}} />
      </div>
      <div class="stat-box stat-gold">
        <div class="stat-label">{{localize "DREADLIGHT.WeaponRange"}}</div>
        <select name="system.range" class="stat-value" style="font-size:var(--t-12);" {{#unless editable}}disabled{{/unless}}>
          <option value="engaged" {{#if (eq system.range "engaged")}}selected{{/if}}>{{localize "DREADLIGHT.RangeEngaged"}}</option>
          <option value="short" {{#if (eq system.range "short")}}selected{{/if}}>{{localize "DREADLIGHT.RangeShort"}}</option>
          <option value="medium" {{#if (eq system.range "medium")}}selected{{/if}}>{{localize "DREADLIGHT.RangeMedium"}}</option>
          <option value="long" {{#if (eq system.range "long")}}selected{{/if}}>{{localize "DREADLIGHT.RangeLong"}}</option>
          <option value="extreme" {{#if (eq system.range "extreme")}}selected{{/if}}>{{localize "DREADLIGHT.RangeExtreme"}}</option>
        </select>
      </div>
    </div>

    {{!-- Gear bonus --}}
    <div class="stat-grid stat-grid-2" style="margin-bottom:12px;">
      <div class="stat-box stat-gold">
        <div class="stat-label">{{localize "DREADLIGHT.GearBonus"}}</div>
        <input class="stat-value" type="number" name="system.gearBonus" value="{{system.gearBonus}}" min="0" max="{{system.gearBonusMax}}" {{#unless editable}}disabled{{/unless}} />
      </div>
      <div class="stat-box stat-gold">
        <div class="stat-label">{{localize "DREADLIGHT.GearBonusMax"}}</div>
        <input class="stat-value" type="number" name="system.gearBonusMax" value="{{system.gearBonusMax}}" min="0" max="4" {{#unless editable}}disabled{{/unless}} />
      </div>
    </div>

    {{!-- Weight --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.Weight"}}</div>
      <div style="display:flex; gap:6px; align-items:center;">
        {{#if editable}}
          <select name="system.weight" style="width:80px;">
            <option value="0" {{#if (eq system.weight 0)}}selected{{/if}}>0</option>
            <option value="0.25" {{#if (eq system.weight 0.25)}}selected{{/if}}>¼</option>
            <option value="0.5" {{#if (eq system.weight 0.5)}}selected{{/if}}>½</option>
            <option value="1" {{#if (eq system.weight 1)}}selected{{/if}}>1</option>
            <option value="2" {{#if (eq system.weight 2)}}selected{{/if}}>2</option>
            <option value="3" {{#if (eq system.weight 3)}}selected{{/if}}>3</option>
          </select>
          <span class="talent-dice-text">slots</span>
        {{else}}
          <span class="tag tag-gold">{{weightLabel system.weight}} slots</span>
        {{/if}}
      </div>
    </div>

    {{!-- Weapon type --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.WeaponType"}}</div>
      {{#if editable}}
        <select name="system.weaponType" style="width:100%;" >
          <option value="melee" {{#if (eq system.weaponType "melee")}}selected{{/if}}>{{localize "DREADLIGHT.WeaponMelee"}}</option>
          <option value="ranged" {{#if (eq system.weaponType "ranged")}}selected{{/if}}>{{localize "DREADLIGHT.WeaponRanged"}}</option>
        </select>
      {{else}}
        <span class="tag tag-red">{{#if (eq system.weaponType "ranged")}}{{localize "DREADLIGHT.WeaponRanged"}}{{else}}{{localize "DREADLIGHT.WeaponMelee"}}{{/if}}</span>
      {{/if}}
    </div>

    {{!-- Properties --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.Properties"}}</div>
      {{#if editable}}
        <input type="text" name="system.properties" value="{{join system.properties ", "}}" style="width:100%;" />
      {{else}}
        <div style="display:flex; gap:4px; flex-wrap:wrap;">
          {{#each system.properties}}
            {{#if this}}<span class="tag tag-red">{{this}}</span>{{/if}}
          {{/each}}
        </div>
      {{/if}}
    </div>

    {{!-- Notes --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.Notes"}}</div>
      <textarea name="system.notes" class="field-textarea" style="min-height:32px;" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
    </div>

  </div>

  {{!-- Bottom accent --}}
  <div class="accent-bottom"></div>

</div>
