<div class="dreadlight sheet item talent {{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}dreadlore{{/if}}">

  {{!-- Corner brackets --}}
  <div class="corner tl"></div>
  <div class="corner tr"></div>
  <div class="corner bl"></div>
  <div class="corner br"></div>

  {{!-- Top accent line --}}
  <div class="accent-top"></div>

  <div class="item-body">

    {{!-- Header: image, type label, name --}}
    <div class="item-header">
      <img class="item-img" src="{{itemIcon item}}" data-fallback-src="{{item.img}}" onerror="this.onerror=null; this.src=this.dataset.fallbackSrc;" data-edit="img" title="{{item.name}}" width="36" height="36" />
      <div style="display:flex; flex-direction:column; gap:2px; flex:1; min-width:0;">
        <div class="item-type-label">{{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}Dreadlore{{else}}{{localize "DREADLIGHT.TypeTalent"}}{{/if}}</div>
        <input class="item-name-input" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}} />
      </div>
    </div>

    {{!-- Level --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.TalentLevel"}}</div>
      <div style="display:flex; gap:8px; align-items:center;">
        <div class="level-pips">
          <div class="level-pip {{#if (gte system.level 1)}}filled{{else}}locked{{/if}}" data-action="set-level" data-level="1">1</div>
          <div class="level-pip {{#if (gte system.level 2)}}filled{{else}}locked{{/if}}" data-action="set-level" data-level="2">2</div>
          <div class="level-pip {{#if (gte system.level 3)}}filled{{else}}locked{{/if}}" data-action="set-level" data-level="3">3</div>
        </div>
        <span class="talent-level-text">{{localize "DREADLIGHT.TalentLevel"}} {{system.level}}</span>
        <span class="talent-dice-text">+{{system.level}} {{localize "DREADLIGHT.TalentDice"}}</span>
      </div>
      <input type="hidden" name="system.level" value="{{system.level}}" />
    </div>

    {{!-- Primary attributes --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.TalentPrimaryAttributes"}}</div>
      {{#if editable}}
        <div class="attr-checkbox-grid">
          {{#each attributeChoices}}
            <label class="attr-checkbox {{#if this.selected}}checked{{/if}}">
              <input type="checkbox" name="system.primaryAttributes" value="{{this.key}}" {{#if this.selected}}checked{{/if}} />
              <span class="attr-checkbox-label">{{upper this.key}}</span>
            </label>
          {{/each}}
        </div>
      {{else}}
        <div class="talent-attr-tags">
          {{#each system.primaryAttributes}}
            <span class="tag tag-gold">{{upper this}}</span>
          {{/each}}
        </div>
      {{/if}}
    </div>

    {{!-- Description / L1 --}}
    <div class="field-group">
      <div class="field-label">{{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}Overview / L1 Minor Lore{{else}}{{localize "DREADLIGHT.Description"}}{{/if}}</div>
      <textarea name="system.description" class="field-textarea" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
    </div>

    {{!-- L2 Perk / Dreadlore Grave Lore --}}
    <div class="perk-box {{#if (gte system.level 2)}}active{{else}}locked{{/if}}">
      <div class="field-label" style="margin-bottom:4px;">
        {{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}L2 Grave Lore{{else}}L2 {{localize "DREADLIGHT.TalentPerk"}}{{/if}}{{#if system.perkName}} - {{system.perkName}}{{/if}}
      </div>
      {{#if editable}}
        <input type="text" name="system.perkName" value="{{system.perkName}}" placeholder="{{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}Grave lore name...{{else}}{{localize "DREADLIGHT.TalentPerkName"}}{{/if}}" style="width:100%; margin-bottom:4px;" />
      {{/if}}
      <textarea name="system.perkDescription" class="field-textarea" style="min-height:48px;" {{#unless editable}}disabled{{/unless}}>{{system.perkDescription}}</textarea>
    </div>

    {{!-- L3 Mastery / Dreadlore Abyssal Lore --}}
    <div class="mastery-box {{#if (gte system.level 3)}}active{{else}}locked{{/if}}">
      <div class="field-label" style="margin-bottom:4px;">
        {{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}L3 Abyssal Lore{{else}}L3 {{localize "DREADLIGHT.TalentMastery"}}{{/if}}{{#if system.masteryName}} - {{system.masteryName}}{{/if}}
      </div>
      {{#if editable}}
        <input type="text" name="system.masteryName" value="{{system.masteryName}}" placeholder="{{#if (or system.isDreadlore (eq system.category 'dreadlore'))}}Abyssal lore name...{{else}}{{localize "DREADLIGHT.TalentMasteryName"}}{{/if}}" style="width:100%; margin-bottom:4px;" />
      {{/if}}
      <textarea name="system.masteryDescription" class="field-textarea" style="min-height:48px;" {{#unless editable}}disabled{{/unless}}>{{system.masteryDescription}}</textarea>
    </div>

  </div>

  {{!-- Bottom accent line --}}
  <div class="accent-bottom"></div>

</div>
