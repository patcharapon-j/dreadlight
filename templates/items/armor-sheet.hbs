<div class="dreadlight sheet item armor">

  {{!-- Corner brackets --}}
  <div class="corner tl"></div>
  <div class="corner tr"></div>
  <div class="corner bl"></div>
  <div class="corner br"></div>

  {{!-- Top accent line (blue variant) --}}
  <div class="accent-top" style="background: linear-gradient(90deg, transparent, rgba(107,157,245,0.3), transparent);"></div>

  <div class="item-body">

    {{!-- Header: image, type label, name --}}
    <div class="item-header" style="border-bottom-color: rgba(107,157,245,0.06);">
      <img class="item-img" src="{{itemIcon item}}" data-fallback-src="{{item.img}}" onerror="this.onerror=null; this.src=this.dataset.fallbackSrc;" data-edit="img" title="{{item.name}}" width="36" height="36"
           style="background: rgba(107,157,245,0.06); border-color: rgba(107,157,245,0.15);" />
      <div style="display:flex; flex-direction:column; gap:2px; flex:1; min-width:0;">
        <div class="item-type-label blue">{{localize "DREADLIGHT.TypeArmor"}}</div>
        <input class="item-name-input" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}} />
      </div>
    </div>

    {{!-- Stat grid (3 columns) --}}
    <div class="stat-grid stat-grid-3" style="margin-bottom:12px;">
      <div class="stat-box stat-blue">
        <div class="stat-label">{{localize "DREADLIGHT.ArmorCurrent"}}</div>
        <input class="stat-value" type="number" name="system.armorCurrent" value="{{system.armorCurrent}}" min="0" max="{{system.armorRating}}" {{#unless editable}}disabled{{/unless}} />
      </div>
      <div class="stat-box stat-blue">
        <div class="stat-label">{{localize "DREADLIGHT.ArmorRating"}}</div>
        <input class="stat-value" type="number" name="system.armorRating" value="{{system.armorRating}}" min="0" max="8" {{#unless editable}}disabled{{/unless}} />
      </div>
      <div class="stat-box stat-gold">
        <div class="stat-label">{{localize "DREADLIGHT.Weight"}}</div>
        <select name="system.weight" class="stat-value" style="font-size:var(--t-12);" {{#unless editable}}disabled{{/unless}}>
          <option value="0" {{#if (eq system.weight 0)}}selected{{/if}}>0</option>
          <option value="0.25" {{#if (eq system.weight 0.25)}}selected{{/if}}>¼</option>
          <option value="0.5" {{#if (eq system.weight 0.5)}}selected{{/if}}>½</option>
          <option value="1" {{#if (eq system.weight 1)}}selected{{/if}}>1</option>
          <option value="2" {{#if (eq system.weight 2)}}selected{{/if}}>2</option>
          <option value="3" {{#if (eq system.weight 3)}}selected{{/if}}>3</option>
        </select>
      </div>
    </div>

    {{!-- Worn toggle (only worn armor is free against carry limit) --}}
    <div class="field-group">
      <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
        <input type="checkbox" name="system.worn" {{#if system.worn}}checked{{/if}} {{#unless editable}}disabled{{/unless}} />
        <span class="field-label" style="margin:0;">{{localize "DREADLIGHT.ArmorWorn"}}</span>
        <span style="font-size:var(--t-11); color:var(--c-text-muted);">{{localize "DREADLIGHT.ArmorWornHint"}}</span>
      </label>
    </div>

    {{!-- Properties --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.Properties"}}</div>
      {{#if editable}}
        <input type="text" name="system.properties" value="{{join system.properties ", "}}" style="width:100%;" />
      {{else}}
        <div style="display:flex; gap:4px; flex-wrap:wrap;">
          {{#each system.properties}}
            {{#if this}}<span class="tag tag-blue">{{this}}</span>{{/if}}
          {{/each}}
        </div>
      {{/if}}
    </div>

    {{!-- Notes --}}
    <div class="field-group">
      <div class="field-label">{{localize "DREADLIGHT.Notes"}}</div>
      <textarea name="system.notes" class="field-textarea" style="min-height:80px;" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea>
    </div>

  </div>

  {{!-- Bottom accent --}}
  <div class="accent-bottom"></div>

</div>
