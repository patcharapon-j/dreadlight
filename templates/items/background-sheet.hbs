<div class="dreadlight sheet item background">
  <div class="accent-top"></div>
  <div class="item-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" width="36" height="36" />
    <div class="item-title">
      <div class="item-type-label gold">{{localize "TYPES.Item.background"}}</div>
      <input class="item-name-input" type="text" name="name" value="{{item.name}}" {{#unless editable}}disabled{{/unless}} />
    </div>
  </div>

  <div class="item-section">
    <div class="field-label">{{localize "DREADLIGHT.Description"}}</div>
    <textarea name="system.description" class="field-textarea" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.description}}</textarea>
  </div>

  <div class="item-section">
    <div class="field-label">{{localize "DREADLIGHT.Vantage"}}</div>
    <input type="text" name="system.vantage" value="{{system.vantage}}" placeholder="{{localize 'DREADLIGHT.VantagePlaceholder'}}" {{#unless editable}}disabled{{/unless}} />
  </div>

  <div class="item-section">
    <div class="field-label">{{localize "DREADLIGHT.BuilderGear"}}</div>
    <input type="text" name="system.startingGear" value="{{system.startingGear}}" {{#unless editable}}disabled{{/unless}} />
  </div>

  <div class="item-section">
    <div class="field-label">{{localize "DREADLIGHT.BuilderSuggestedTalents"}}</div>
    <input type="text" name="system.suggestedTalents" value="{{system.suggestedTalents}}" {{#unless editable}}disabled{{/unless}} />
  </div>
</div>
