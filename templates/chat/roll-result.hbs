<div class="dreadlight-chat {{#if direFailure}}chat-dire{{else}}chat-{{outcome}}{{/if}} {{#if pushed}}pushed{{/if}}" data-sixes="{{totalSixes}}" data-has-ones="{{#if hasOnes}}true{{else}}false{{/if}}">
  <div class="chat-accent"></div>

  <div class="chat-header {{#unless showPortrait}}no-portrait{{/unless}}">
    {{#if showPortrait}}
    <div class="chat-portrait-bg"></div>
    <div class="chat-portrait" style="background-image: url('{{actorImg}}'); transform: translate({{portraitChat.offsetX}}px, {{portraitChat.offsetY}}px) scale({{portraitChat.zoom}});"></div>
    <div class="chat-portrait-fade"></div>
    {{/if}}
    <div class="chat-name">{{actorName}}</div>
  </div>

  <div class="chat-info">
    <div class="chat-action">
      {{#if talentName}}<span class="chat-talent">{{talentName}}</span> — {{/if}}
      {{attrName attribute}}
      ({{capitalize difficulty}})
      {{#if pushed}}<span class="chat-pushed">⟳ {{localize "DREADLIGHT.ResultPushed"}}</span>{{/if}}
    </div>
    {{#if gearName}}<div class="chat-gear-used"><i class="dl-sigil dl-sigil-equipment"></i> {{gearName}}</div>{{/if}}
  </div>

  <div class="chat-dice">
    {{#if baseResults.length}}
      <div class="dice-group group-base">
        <span class="dice-label label-base">{{localize "DREADLIGHT.Base"}}</span>
        {{#each baseResults}}
          <div class="die die-base {{#if (eq this 6)}}six{{else}}{{#if (eq this 1)}}one{{else}}normal{{/if}}{{/if}} {{#if (and ../pushed (or (eq this 1) (eq this 6)))}}locked{{/if}}">{{#if (eq this 6)}}<img src="systems/dreadlight/assets/dice/success.png" class="die-icon">{{else if (eq this 1)}}<img src="systems/dreadlight/assets/dice/bane.png" class="die-icon">{{/if}}</div>
        {{/each}}
      </div>
    {{/if}}
    {{#if dreadResults.length}}
      <div class="dice-group group-dread">
        <span class="dice-label label-dread">{{localize "DREADLIGHT.Dread"}}</span>
        {{#each dreadResults}}
          <div class="die die-dread {{#if (eq this 6)}}six{{else}}{{#if (eq this 1)}}one{{else}}normal{{/if}}{{/if}} {{#if (and ../pushed (or (eq this 1) (eq this 6)))}}locked{{/if}}">{{#if (eq this 6)}}<img src="systems/dreadlight/assets/dice/success.png" class="die-icon">{{else if (eq this 1)}}<img src="systems/dreadlight/assets/dice/bane.png" class="die-icon">{{/if}}</div>
        {{/each}}
      </div>
    {{/if}}
    {{#if gearResults.length}}
      <div class="dice-group group-gear">
        <span class="dice-label label-gear">{{localize "DREADLIGHT.Gear"}}</span>
        {{#each gearResults}}
          <div class="die die-gear {{#if (eq this 6)}}six{{else}}{{#if (eq this 1)}}one{{else}}normal{{/if}}{{/if}} {{#if (and ../pushed (or (eq this 1) (eq this 6)))}}locked{{/if}}">{{#if (eq this 6)}}<img src="systems/dreadlight/assets/dice/success.png" class="die-icon">{{else if (eq this 1)}}<img src="systems/dreadlight/assets/dice/bane.png" class="die-icon">{{/if}}</div>
        {{/each}}
      </div>
    {{/if}}
  </div>

  <div class="chat-result">
    <div class="result-row">
      {{#if (eq outcome "success")}}<span class="result-icon gold"><i class="dl-sigil dl-sigil-success"></i></span>{{/if}}
      {{#if (eq outcome "tainted")}}<span class="result-icon purple"><i class="dl-sigil dl-sigil-tainted"></i></span>{{/if}}
      {{#if (eq outcome "failure")}}{{#if direFailure}}<span class="result-icon red dire-glow"><i class="dl-sigil dl-sigil-dire"></i></span>{{else}}<span class="result-icon muted"><i class="dl-sigil dl-sigil-failure"></i></span>{{/if}}{{/if}}

      <span class="result-label">
        {{#if (eq outcome "success")}}{{localize "DREADLIGHT.ResultSuccess"}}{{/if}}
        {{#if (eq outcome "tainted")}}{{localize "DREADLIGHT.ResultTaintedSuccess"}}{{/if}}
        {{#if direFailure}}{{localize "DREADLIGHT.ResultDireFailure"}}{{else if (eq outcome "failure")}}{{localize "DREADLIGHT.ResultFailure"}}{{/if}}
      </span>

      <span class="result-count">
        <span class="result-count-num">{{totalSixes}}</span> {{#if (eq totalSixes 1)}}{{localize "DREADLIGHT.Success"}}{{else}}{{localize "DREADLIGHT.Successes"}}{{/if}}
      </span>
    </div>

    {{#if showTaintedFlavorText}}{{#if (eq outcome "tainted")}}
      <div class="dire-flavor"><span class="flavor-mark">"</span>{{localize "DREADLIGHT.TaintedFlavorText"}}<span class="flavor-mark">"</span></div>
    {{/if}}{{/if}}
    {{#if showTaintedFlavorText}}{{#if direFailure}}
      <div class="dire-flavor"><span class="flavor-mark">"</span>{{localize "DREADLIGHT.DireFailureFlavorText"}}<span class="flavor-mark">"</span></div>
    {{/if}}{{/if}}

    {{#if consequences}}
      {{#if consequences.mindLoss}}<div class="consequence consequence-mind"><i class="dl-sigil dl-sigil-mind"></i> <strong>−{{consequences.mindLoss}} {{localize "DREADLIGHT.PushCostMind"}}</strong></div>{{/if}}
      {{#if consequences.soulLoss}}<div class="consequence consequence-soul"><i class="dl-sigil dl-sigil-soul"></i> <strong>−{{consequences.soulLoss}} {{localize "DREADLIGHT.PushCostSoul"}}</strong></div>{{/if}}
      {{#if consequences.gearDamage}}<div class="consequence consequence-gear"><i class="dl-sigil dl-sigil-equipment"></i> <strong>{{localize "DREADLIGHT.PushCostGear"}} −{{consequences.gearDamage}}</strong></div>{{/if}}
    {{/if}}

    {{#if hasWeapon}}{{#unless (eq outcome "failure")}}
      <div class="damage-card {{#if isCritical}}damage-critical{{/if}}">
        <span class="damage-corner tl"></span>
        <span class="damage-corner tr"></span>
        <span class="damage-corner bl"></span>
        <span class="damage-corner br"></span>

        <div class="damage-card-body">
          <div class="damage-card-meta">
            <span class="damage-card-icon"><i class="dl-sigil dl-sigil-weapon"></i></span>
            <div class="damage-card-titles">
              <span class="damage-card-title">{{localize "DREADLIGHT.DamageDealt"}}</span>
              <span class="damage-card-formula">
                <span class="damage-formula-base">{{weaponDamage}}</span>
                <span class="damage-formula-op">{{localize "DREADLIGHT.DamageBase"}}</span>
                {{#if extraSuccesses}}<span class="damage-formula-sep">·</span><span class="damage-formula-extra">+{{extraSuccesses}}</span><span class="damage-formula-op">{{localize "DREADLIGHT.DamageExtra"}}</span>{{/if}}
              </span>
            </div>
          </div>
          <div class="damage-card-stamp">
            <span class="damage-stamp-num">{{totalDamage}}</span>
            <span class="damage-stamp-label">DMG</span>
          </div>
        </div>
      </div>
      {{#if isCritical}}
        <div class="damage-crit-stamp">
          <span class="crit-stamp-bar left"></span>
          <span class="crit-stamp-text">
            <span class="crit-stamp-main"><span class="crit-stamp-icon"><i class="dl-sigil dl-sigil-dire"></i></span>{{localize "DREADLIGHT.DamageCritical"}}<span class="crit-stamp-icon"><i class="dl-sigil dl-sigil-dire"></i></span></span>
            <span class="crit-stamp-sub">{{totalDamage}} damage ≥ crit threshold {{weaponCritThreshold}}</span>
          </span>
          <span class="crit-stamp-bar right"></span>
        </div>
      {{/if}}
    {{/unless}}{{/if}}
  </div>

  {{#unless pushed}}
    <div class="push-bar">
      <button type="button" class="push-btn">
        <i class="dl-sigil dl-sigil-push push-btn-icon"></i>
        <span class="push-btn-label">{{localize "DREADLIGHT.Push"}}</span>
        <span class="push-hint">{{localize "DREADLIGHT.PushHint"}}</span>
      </button>
    </div>
  {{/unless}}
</div>
