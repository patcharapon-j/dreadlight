<div class="dreadlight-chat chat-{{outcome}} adhoc-roll">
  <div class="chat-accent"></div>

  {{#if hasActor}}
  <div class="chat-header {{#unless showPortrait}}no-portrait{{/unless}}">
    {{#if showPortrait}}
    <div class="chat-portrait" style="background-image: url('{{actorImg}}'); transform: translate({{portraitChat.offsetX}}px, {{portraitChat.offsetY}}px) scale({{portraitChat.zoom}});"></div>
    <div class="chat-portrait-fade"></div>
    {{/if}}
    <div class="chat-name">{{userName}}</div>
  </div>
  {{/if}}

  <div class="chat-info adhoc-info">
    <div class="chat-action">
      {{#unless hasActor}}<span class="adhoc-roller-name">{{userName}}</span> — {{/unless}}
      {{localize "DREADLIGHT.AdhocRoll"}}
    </div>
  </div>

  <div class="chat-dice">
    {{#if baseResults.length}}
      <div class="dice-group group-base">
        <span class="dice-label label-base">{{localize "DREADLIGHT.Base"}}</span>
        {{#each baseResults}}
          <div class="die die-base {{#if (eq this 6)}}six{{else}}{{#if (eq this 1)}}one{{else}}normal{{/if}}{{/if}}">{{#if (eq this 6)}}<img src="systems/dreadlight/assets/dice/success.png" class="die-icon">{{else if (eq this 1)}}<img src="systems/dreadlight/assets/dice/bane.png" class="die-icon">{{/if}}</div>
        {{/each}}
      </div>
    {{/if}}
    {{#if dreadResults.length}}
      <div class="dice-group group-dread">
        <span class="dice-label label-dread">{{localize "DREADLIGHT.Dread"}}</span>
        {{#each dreadResults}}
          <div class="die die-dread {{#if (eq this 6)}}six{{else}}{{#if (eq this 1)}}one{{else}}normal{{/if}}{{/if}}">{{#if (eq this 6)}}<img src="systems/dreadlight/assets/dice/success.png" class="die-icon">{{else if (eq this 1)}}<img src="systems/dreadlight/assets/dice/bane.png" class="die-icon">{{/if}}</div>
        {{/each}}
      </div>
    {{/if}}
    {{#if gearResults.length}}
      <div class="dice-group group-gear">
        <span class="dice-label label-gear">{{localize "DREADLIGHT.Gear"}}</span>
        {{#each gearResults}}
          <div class="die die-gear {{#if (eq this 6)}}six{{else}}{{#if (eq this 1)}}one{{else}}normal{{/if}}{{/if}}">{{#if (eq this 6)}}<img src="systems/dreadlight/assets/dice/success.png" class="die-icon">{{else if (eq this 1)}}<img src="systems/dreadlight/assets/dice/bane.png" class="die-icon">{{/if}}</div>
        {{/each}}
      </div>
    {{/if}}
  </div>

  <div class="chat-result">
    <div class="result-row">
      {{#if (eq outcome "clean")}}<span class="result-icon gold">✦</span>{{/if}}
      {{#if (eq outcome "tainted")}}<span class="result-icon purple">⬡</span>{{/if}}
      {{#if (eq outcome "dire")}}<span class="result-icon red dire-glow">◆</span>{{/if}}
      {{#if (eq outcome "failure")}}{{#if direFailure}}<span class="result-icon red dire-glow">✕</span>{{else}}<span class="result-icon muted">✕</span>{{/if}}{{/if}}

      <span class="result-label">
        {{#if (eq outcome "clean")}}{{localize "DREADLIGHT.ResultCleanSuccess"}}{{/if}}
        {{#if (eq outcome "tainted")}}{{localize "DREADLIGHT.ResultTaintedSuccess"}}{{/if}}
        {{#if (eq outcome "dire")}}{{localize "DREADLIGHT.ResultDireSuccess"}}{{/if}}
        {{#if (eq outcome "failure")}}{{#if direFailure}}{{localize "DREADLIGHT.ResultDireFailure"}}{{else}}{{localize "DREADLIGHT.ResultFailure"}}{{/if}}{{/if}}
      </span>

      <span class="result-count">
        <span class="result-count-num">{{totalSixes}}</span> {{#if (eq totalSixes 1)}}{{localize "DREADLIGHT.Success"}}{{else}}{{localize "DREADLIGHT.Successes"}}{{/if}}
      </span>
    </div>
  </div>
</div>
