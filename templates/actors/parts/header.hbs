<div class="sheet-header">
  <div class="header-bg"></div>
  {{#if anyBroken}}
    <div class="broken-overlay" aria-hidden="true">
      <div class="broken-text-track">BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN</div>
      <div class="broken-text-track reverse">BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN</div>
      <div class="broken-text-track">BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN BROKEN</div>
    </div>
  {{/if}}
  <figure class="portrait-figure">
    <img src="{{actor.img}}" alt="{{actor.name}}" style="transform: translate({{system.portrait.sheet.offsetX}}px, {{system.portrait.sheet.offsetY}}px) scale({{system.portrait.sheet.zoom}});" />
    {{#if editMode}}
      <div class="portrait-edit-overlay" data-action="editPortrait"><i class="fa-solid fa-camera"></i></div>
    {{/if}}
  </figure>
  <div class="header-identity">
    <input class="name-input" type="text" name="name" value="{{actor.name}}" placeholder="Character Name" />
    <div class="concept-row">
      {{#if system.details.drive}}
        <span class="tag tag-drive header-drive">{{system.details.drive}}</span>
      {{/if}}
      <input class="concept-input" type="text" name="system.concept" value="{{system.concept}}" placeholder="One-sentence concept..." />
    </div>
    <div class="tags">
      {{#each backgroundTags}}
        <span class="tag-group">
          <span class="tag tag-bg">{{this.name}}</span>
          {{#each this.vantages}}
            <span class="tag tag-vantage">{{this}}</span>
          {{/each}}
        </span>
      {{/each}}
    </div>
  </div>
</div>
