<div class="carry-bar">
  <span class="carry-label">{{localize "DREADLIGHT.Carry"}}</span>
  <div class="carry-pips">{{{carryPips carryUsed carryLimit}}}</div>
  <span class="carry-num">{{weightLabel carryUsed}} / {{carryLimit}}</span>
</div>

<div class="section-header"><span>{{localize "DREADLIGHT.Weapons"}}</span><div class="section-line"></div></div>
{{#each weapons}}
  <div class="item-row weapon-row" data-item-id="{{this.id}}">
    <div class="item-icon red art"><img src="{{itemIcon this}}" data-fallback-src="{{this.img}}" onerror="this.onerror=null; this.src=this.dataset.fallbackSrc;" alt="" /></div>
    <div class="item-info" data-action="toggleExpand">
      <div class="item-name">{{this.name}}</div>
      <div class="item-meta">
        {{#if (eq this.system.weaponType "melee")}}Melee{{else}}Ranged{{/if}}
        · {{capitalize this.system.range}}
        {{#each this.system.properties}} <span class="tag tag-red">{{this}}</span>{{/each}}
      </div>
    </div>
    <div class="item-stat stat-red">DMG {{this.system.damage}}</div>
    <div class="item-stat stat-gold">CRIT {{this.system.critThreshold}}</div>
    {{#if this.system.gearBonusMax}}
      <div class="item-pips" data-item-id="{{this.id}}" data-field="system.gearBonus" data-max="{{this.system.gearBonusMax}}">
        {{{gearPips this.system.gearBonus this.system.gearBonusMax "gold"}}}
      </div>
    {{/if}}
    <button type="button" class="weapon-roll-btn" data-action="rollWeapon" title="{{localize "DREADLIGHT.RollButton"}}"><i class="fa-solid fa-dice-d6"></i></button>
  </div>
  <div class="item-expand" data-expand-id="{{this.id}}">
    <div class="expand-inner">
      {{#if this.system.notes}}<div class="expand-description">{{{this.system.notes}}}</div>{{/if}}
    </div>
  </div>
{{/each}}

<div class="section-header"><span>{{localize "DREADLIGHT.Armor"}}</span><div class="section-line"></div></div>
{{#each armors}}
  <div class="item-row armor-row" data-item-id="{{this.id}}">
    <div class="item-icon mind art"><img src="{{itemIcon this}}" data-fallback-src="{{this.img}}" onerror="this.onerror=null; this.src=this.dataset.fallbackSrc;" alt="" /></div>
    <div class="item-info" data-action="toggleExpand">
      <div class="item-name">{{this.name}}</div>
      <div class="item-meta">{{#each this.system.properties}}<span class="tag">{{this}}</span>{{/each}}</div>
    </div>
    <div class="item-stat stat-blue">AR {{this.system.armorRating}}</div>
    {{#if this.system.armorRating}}
      <div class="item-pips" data-item-id="{{this.id}}" data-field="system.armorCurrent" data-max="{{this.system.armorRating}}">
        {{{gearPips this.system.armorCurrent this.system.armorRating "blue"}}}
      </div>
    {{/if}}
    <button type="button" class="armor-roll-btn" data-action="rollArmor" title="{{localize "DREADLIGHT.Armor"}}"><i class="dl-sigil dl-sigil-armor"></i></button>
  </div>
  <div class="item-expand" data-expand-id="{{this.id}}">
    <div class="expand-inner">
      {{#if this.system.notes}}<div class="expand-description">{{{this.system.notes}}}</div>{{/if}}
    </div>
  </div>
{{/each}}

<div class="section-header"><span>{{localize "DREADLIGHT.Gear"}}</span><div class="section-line"></div></div>
{{#each equipment}}
  <div class="item-row gear-row" data-item-id="{{this.id}}">
    <div class="item-icon gold art"><img src="{{itemIcon this}}" data-fallback-src="{{this.img}}" onerror="this.onerror=null; this.src=this.dataset.fallbackSrc;" alt="" /></div>
    <div class="item-info" data-action="toggleExpand">
      <div class="item-name">{{this.name}}</div>
      <div class="item-meta">{{#each this.system.applicableTalents}}<span class="tag tag-gold">{{this}}</span>{{/each}}</div>
    </div>
    {{#if this.system.gearBonusMax}}
      <div class="item-pips" data-item-id="{{this.id}}" data-field="system.gearBonus" data-max="{{this.system.gearBonusMax}}">
        {{{gearPips this.system.gearBonus this.system.gearBonusMax "gold"}}}
      </div>
    {{/if}}
  </div>
  <div class="item-expand" data-expand-id="{{this.id}}">
    <div class="expand-inner">
      {{#if this.system.description}}<div class="expand-description">{{{this.system.description}}}</div>{{/if}}
    </div>
  </div>
{{/each}}

<div class="drop-zone">{{localize "DREADLIGHT.DropItems"}}</div>
