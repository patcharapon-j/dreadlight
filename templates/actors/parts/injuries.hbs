<div class="injuries-section">
  <div class="section-header">
    <span>{{localize "DREADLIGHT.Injuries"}}</span>
    <div class="section-line"></div>
  </div>

  {{#each injuries}}
    <div class="injury-entry injury-{{this.track}} {{#if this.lethal}}injury-lethal{{/if}}">
      <div class="injury-header">
        <div class="injury-dot {{this.track}}"></div>
        {{#if ../editMode}}
          <input type="text" class="injury-input injury-input-name injury-field" data-index="{{@index}}" data-field="name" value="{{this.name}}">
        {{else}}
          <span class="injury-name">{{this.name}}</span>
        {{/if}}
        <span class="injury-d66">{{this.d66Key}}</span>
        {{#if this.penalty}}
          <span class="injury-penalty-badge">−{{this.penalty}}</span>
        {{/if}}
        {{#if ../editMode}}
          <button type="button" class="delete-injury" data-action="deleteInjury" data-index="{{@index}}">✕</button>
        {{/if}}
      </div>
      {{#if ../editMode}}
        <textarea class="injury-input injury-input-effect injury-field" data-index="{{@index}}" data-field="effect" rows="2">{{this.effect}}</textarea>
        <div class="injury-edit-row">
          <label class="injury-edit-field">
            <span class="injury-edit-label">{{localize "DREADLIGHT.D66HealTime"}}</span>
            <input type="text" class="injury-input injury-input-heal injury-field" data-index="{{@index}}" data-field="healTime" value="{{this.healTime}}">
          </label>
          <label class="injury-edit-field">
            <span class="injury-edit-label">{{localize "DREADLIGHT.InjuryPenalty"}}</span>
            <input type="number" class="injury-input injury-input-penalty injury-field" data-index="{{@index}}" data-field="penalty" value="{{this.penalty}}" min="0">
          </label>
          <label class="injury-edit-field injury-edit-lethal">
            <input type="checkbox" class="injury-field" data-index="{{@index}}" data-field="lethal" {{#if this.lethal}}checked{{/if}}>
            <span class="injury-lethal-check"></span>
            <span class="injury-edit-label">{{localize "DREADLIGHT.D66Lethal"}}</span>
          </label>
        </div>
      {{else}}
        <div class="injury-effect">{{this.effect}}</div>
        <div class="injury-heal">{{localize "DREADLIGHT.D66HealTime"}}: {{this.healTime}}</div>
      {{/if}}
    </div>
  {{/each}}

  {{#unless injuries.length}}
    <div class="injuries-empty">{{localize "DREADLIGHT.InjuriesNone"}}</div>
  {{/unless}}
</div>
