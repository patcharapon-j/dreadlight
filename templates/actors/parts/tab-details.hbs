<div class="section-header"><span>{{localize "DREADLIGHT.Backgrounds"}}</span><div class="section-line"></div></div>
<div class="bg-cards">
  {{#each system.backgrounds}}
  <div class="bg-card">
    <div class="field-label">{{#if (eq @index 0)}}{{localize "DREADLIGHT.Background1"}}{{else}}{{localize "DREADLIGHT.Background2"}}{{/if}}</div>
    {{#if ../editMode}}
      <input type="text" name="system.backgrounds.{{@index}}.name" value="{{this.name}}" placeholder="Background name..." />
      <textarea name="system.backgrounds.{{@index}}.desc" rows="2" placeholder="Skills, knowledge...">{{this.desc}}</textarea>
      <div class="field-label vantage-label">{{localize "DREADLIGHT.Vantage"}}</div>
      <input type="text" name="system.backgrounds.{{@index}}.vantage" value="{{this.vantage}}" placeholder="{{localize "DREADLIGHT.VantagePlaceholder"}}" />
    {{else}}
      <div class="bg-name">{{this.name}}</div>
      {{#if this.desc}}
        <div class="bg-desc">{{this.desc}}</div>
      {{/if}}
      {{#if this.vantage}}
        <div class="vantage-list">
          {{#each (split this.vantage ";")}}
            <span class="vantage-tag">{{this}}</span>
          {{/each}}
        </div>
      {{/if}}
    {{/if}}
  </div>
  {{/each}}
</div>

<div class="section-header personal-header"><span>{{localize "DREADLIGHT.Personal"}}</span><div class="section-line"></div></div>

<div class="field-group">
  <div class="field-label">{{localize "DREADLIGHT.Anchor"}} <span class="hint-green">♥ {{localize "DREADLIGHT.AnchorHint"}}</span></div>
  {{#if editMode}}
    <textarea name="system.details.anchor" rows="2">{{system.details.anchor}}</textarea>
  {{else}}
    <div class="detail-box anchor-box">{{system.details.anchor}}</div>
  {{/if}}
</div>

<div class="field-group">
  <div class="field-label">{{localize "DREADLIGHT.Drive"}}</div>
  {{#if editMode}}
    <input type="text" name="system.details.drive" value="{{system.details.drive}}" placeholder="Drive name..." />
    <textarea name="system.details.driveDesc" rows="1" placeholder="Description...">{{system.details.driveDesc}}</textarea>
  {{else}}
    {{#if system.details.drive}}
      <div class="detail-box drive-box">
        <span class="tag tag-drive">{{system.details.drive}}</span>
        {{#if system.details.driveDesc}}
          <span class="drive-desc">{{system.details.driveDesc}}</span>
        {{/if}}
      </div>
    {{/if}}
  {{/if}}
</div>

<div class="field-group">
  <div class="field-label">{{localize "DREADLIGHT.Fear"}} <span class="hint-red">⚠ {{localize "DREADLIGHT.FearHint"}}</span></div>
  {{#if editMode}}
    <textarea name="system.details.fear" rows="2" class="fear-field">{{system.details.fear}}</textarea>
  {{else}}
    <div class="detail-box fear-box">{{system.details.fear}}</div>
  {{/if}}
</div>

<div class="section-header"><span>{{localize "DREADLIGHT.Connections"}}</span><div class="section-line"></div></div>
{{#each system.details.connections}}
  <div class="connection-row {{#unless ../editMode}}play-mode{{/unless}}" data-index="{{@index}}">
    {{#if ../editMode}}
      <input type="text" name="system.details.connections.{{@index}}.name" value="{{this.name}}" placeholder="Name" class="conn-name" />
      <textarea name="system.details.connections.{{@index}}.text" rows="1" placeholder="Relationship..." class="conn-text">{{this.text}}</textarea>
      <button type="button" class="delete-btn" data-action="deleteConnection" data-index="{{@index}}">✕</button>
    {{else}}
      <div class="conn-icon">PC</div>
      <div class="conn-info">
        <div class="conn-display-name">{{this.name}}</div>
        <div class="conn-display-text">{{this.text}}</div>
      </div>
    {{/if}}
  </div>
{{/each}}
{{#if editMode}}
  <button type="button" class="add-connection" data-action="addConnection">+ Connection</button>
{{/if}}
