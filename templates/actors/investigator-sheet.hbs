<div class="dreadlight sheet investigator {{#if editMode}}is-editing{{/if}} {{#if anyBroken}}is-broken{{/if}}">
  <div class="corner tl"></div>
  <div class="corner tr"></div>
  <div class="corner bl"></div>
  <div class="corner br"></div>
  <div class="accent-top"></div>

  {{#if editable}}
    <button type="button" class="character-builder-btn" data-action="openCharacterBuilder" title="{{localize 'DREADLIGHT.CharacterBuilder'}}">
      <i class="fa-solid fa-user-gear"></i>
    </button>
    <button type="button" class="edit-toggle-btn" data-action="toggleEditMode" title="{{#if editMode}}Play Mode{{else}}Edit Mode{{/if}}">
      {{#if editMode}}<i class="fa-solid fa-lock-open"></i>{{else}}<i class="fa-solid fa-pen"></i>{{/if}}
    </button>
  {{/if}}

  {{> "systems/dreadlight/templates/actors/parts/header.hbs"}}
  {{> "systems/dreadlight/templates/actors/parts/tracks.hbs"}}

  <div class="sheet-body">
    <div class="col-left">
      {{> "systems/dreadlight/templates/actors/parts/attributes.hbs"}}
      {{> "systems/dreadlight/templates/actors/parts/injuries.hbs"}}
      <div class="xp-box">
        <div class="section-label">{{localize "DREADLIGHT.XP"}}</div>
        <div class="xp-value">
          <input type="number" name="system.advancement.xp" value="{{system.advancement.xp}}" data-dtype="Number" min="0" />
        </div>
        <div class="xp-spent">{{localize "DREADLIGHT.XPSpent"}}: {{system.advancement.spent}} | {{localize "DREADLIGHT.AdvancementAvailableXP"}}: {{availableXp}}</div>
        <button type="button" class="xp-advance-btn" data-action="openAdvancement" title="{{localize 'DREADLIGHT.Advancement'}}">
          <i class="fa-solid fa-arrow-up-right-dots"></i>
          <span>{{localize "DREADLIGHT.Advancement"}}</span>
        </button>
      </div>
    </div>

    <div class="col-right">
      <nav class="tab-bar">
        <a class="tab {{#if (eq tab "talents")}}active{{/if}}" data-tab="talents">{{localize "DREADLIGHT.TabTalents"}}</a>
        <a class="tab {{#if (eq tab "equipment")}}active{{/if}}" data-tab="equipment">{{localize "DREADLIGHT.TabEquipment"}}</a>
        <a class="tab {{#if (eq tab "details")}}active{{/if}}" data-tab="details">{{localize "DREADLIGHT.TabDetails"}}</a>
      </nav>
      <div class="tab-content">
        <div class="tab {{#if (eq tab "talents")}}active{{/if}}" data-tab="talents">
          {{> "systems/dreadlight/templates/actors/parts/tab-talents.hbs"}}
        </div>
        <div class="tab {{#if (eq tab "equipment")}}active{{/if}}" data-tab="equipment">
          {{> "systems/dreadlight/templates/actors/parts/tab-equipment.hbs"}}
        </div>
        <div class="tab {{#if (eq tab "details")}}active{{/if}}" data-tab="details">
          {{> "systems/dreadlight/templates/actors/parts/tab-details.hbs"}}
        </div>
      </div>
    </div>
  </div>

  <div class="accent-bottom"></div>
</div>
